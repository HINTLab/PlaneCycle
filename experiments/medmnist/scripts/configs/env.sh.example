# Template for the site-specific settings submit.sh needs.
#
#   cp env.sh.example env.sh     # then edit env.sh with your values
#
# env.sh is git-ignored (stays private); this .example is committed so others
# know what to set. Keeps the cluster/interpreter details out of the scripts.
# (run.sh carries its own ROOT_DIR / CONDA_ENV / #SBATCH partition, so a bare
#  `sbatch run.sh ...` works without submit.sh; see run.sh.example.)

# Python interpreter used on the LOGIN node (submit.sh calls it to size the
# array). Use a full path so no `conda activate` is needed there.
PY="/path/to/conda/envs/yourenv/bin/python"

# Slurm GPU partition(s). submit.sh passes this as `sbatch --partition=...`.
PARTITION="your-gpu-partition"

# Conda env that run.sh activates on the COMPUTE node (leave "" to skip).
CONDA_ENV="yourenv"
